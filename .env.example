# Payload secret — used to sign/encrypt sessions & tokens. Keep private.
PAYLOAD_SECRET=

# Postgres connection string for Payload.
# Local dev example (Homebrew/Docker): postgres://USER:PASSWORD@127.0.0.1:5432/farah_atelier
# Managed (Neon/Supabase): paste the pooled connection string here.
DATABASE_URL=

# Public URL of this deployment — used by Payload for CORS and media URLs.
# Set to your Vercel URL (or custom domain) in production.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Resend API key for sending contact-form emails. Get from resend.com dashboard.
RESEND_API_KEY=

# Sender address for outgoing contact-form emails.
# Use Resend's sandbox address (onboarding@resend.dev) until a custom domain
# is verified in Resend — the sandbox sender can only deliver to the Resend
# account owner's own email, so local testing must send TO that address.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Cloudflare Turnstile secret key — verifies the widget token server-side
# before /api/contact sends any email. Get from the Cloudflare dashboard
# (Turnstile) or `wrangler turnstile widget create`. The sitekey is public
# and hardcoded in the form components; only the secret goes here.
TURNSTILE_SECRET=
