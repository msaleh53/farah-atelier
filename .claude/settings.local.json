{
  "permissions": {
    "allow": [
      "Bash(npm -v)",
      "Bash(npm install *)",
      "Bash(npm run *)",
      "Bash(curl -s -o /dev/null -w '%{http_code}' http://localhost:3001/)",
      "Bash(echo \"3001 /:        $\\(curl -s -o /dev/null -w '%{http_code}' http://localhost:3001/\\)\")",
      "Bash(curl -s -o /dev/null -w '%{http_code}' http://localhost:3001/gallery)",
      "Bash(echo \"3001 /gallery: $\\(curl -s -o /dev/null -w '%{http_code}' http://localhost:3001/gallery\\)\")",
      "Bash(curl -s -o /dev/null -w '%{http_code}' http://localhost:3000/)",
      "Bash(xargs kill)",
      "Bash(echo \"3000 now: $\\(curl -s -o /dev/null -w '%{http_code}' http://localhost:3000/ || echo down\\)\")",
      "Bash(echo \"3001 dev: $\\(curl -s -o /dev/null -w '%{http_code}' http://localhost:3001/\\)\")",
      "Bash(git rev-parse *)",
      "Bash(git config *)",
      "Bash(git init *)",
      "Bash(git add *)"
    ]
  }
}
